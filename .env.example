# TrafficLens API Gateway Configuration Template

# Server Bind Settings
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501

# PostgreSQL Database URL
# Format: postgresql+psycopg://username:password@hostname:port/dbname
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/trafficlens

# Fixed-Window Rate Limiting Settings
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Backend Health Checker Settings
HEALTH_CHECK_INTERVAL_SECONDS=10
HEALTH_CHECK_TIMEOUT_SECONDS=2.0
UNHEALTHY_AFTER_FAILURES=2
HEALTHY_AFTER_SUCCESSES=1

# Gateway HTTP Forwarding Proxy Settings
UPSTREAM_TIMEOUT_SECONDS=5.0
REUSE_UPSTREAM_CONNECTIONS=true

# Telemetry Persistence Settings
METRICS_FLUSH_INTERVAL_SECONDS=1.0

# Dashboard Frontend Settings
DASHBOARD_REFRESH_INTERVAL_MS=1000
DASHBOARD_TIME_WINDOW_SECONDS=60
